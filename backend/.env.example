# Copy this file to .env and update values for your local machine

DB_USER=postgres
DB_HOST=localhost
DB_NAME=MiniProject
DB_PASSWORD=your-password-here

# Build DATABASE_URL from the values above.
# If your password contains special characters (@, #, etc.), URL-encode them.
# Example: Rise@-1 becomes Rise%40-1
DATABASE_URL=postgresql://postgres:your-password-here@localhost:5432/MiniProject

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=1440

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# Fallback when Gemini fails (quota, outage, etc.) — get a key at https://console.groq.com/
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# Which provider to try first: auto | gemini | groq
AI_PROVIDER=auto
